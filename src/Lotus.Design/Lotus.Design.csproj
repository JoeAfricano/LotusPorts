<Project Sdk="Microsoft.NET.Sdk">
  <!-- Visual tokens, styles and small controls shared by Lotus and Lotus Ports. No app logic here. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Lotus.Design</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Keep the compiled theme as a loose Lotus.Design\*.xbf file in every configuration (as Debug does): an
         unpackaged app does not read XAML embedded in a library's .pri, so Release builds could not load the theme. -->
    <DisableEmbeddedXbf>true</DisableEmbeddedXbf>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
  </ItemGroup>
</Project>
