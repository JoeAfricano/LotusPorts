<Window
    x:Class="LotusPorts.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Lotus.Design.Controls"
    xmlns:local="using:LotusPorts.App">

    <Grid Background="{StaticResource Bg.Base}">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator
                Invoked="OnSearchShortcut"
                Key="K"
                Modifiers="Control" />
        </Grid.KeyboardAccelerators>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Sidebar  -->
        <Grid
            Padding="16,22,16,18"
            Background="{StaticResource Bg.Sidebar}"
            BorderBrush="{StaticResource Stroke.Subtle}"
            BorderThickness="0,0,1,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel
                Margin="6,6,0,30"
                Orientation="Horizontal"
                Spacing="12">
                <controls:LotusPetal
                    Width="46"
                    Height="40"
                    IsLit="True" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        CharacterSpacing="60"
                        FontFamily="Segoe UI Variable Display"
                        FontSize="23"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Text.Primary}"
                        Text="LOTUS" />
                    <TextBlock
                        Margin="1,-2,0,0"
                        CharacterSpacing="560"
                        FontSize="12"
                        Foreground="{StaticResource Accent.Rose}"
                        Text="PORTS" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="1" Spacing="4">
                <RadioButton
                    x:Name="NavHome"
                    AutomationProperties.Name="{local:Str Key=NavHome}"
                    Checked="OnNavChecked"
                    GroupName="Nav"
                    Style="{StaticResource Lotus.NavItem}"
                    Tag="home">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <FontIcon FontSize="16" Glyph="&#xE80F;" />
                        <TextBlock Text="{local:Str Key=NavHome}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton
                    x:Name="NavLibrary"
                    AutomationProperties.Name="{local:Str Key=NavLibrary}"
                    Checked="OnNavChecked"
                    GroupName="Nav"
                    Style="{StaticResource Lotus.NavItem}"
                    Tag="library">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <FontIcon FontSize="16" Glyph="&#xE7FC;" />
                        <TextBlock Text="{local:Str Key=NavLibrary}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton
                    x:Name="NavCatalog"
                    AutomationProperties.Name="{local:Str Key=NavCatalog}"
                    Checked="OnNavChecked"
                    GroupName="Nav"
                    Style="{StaticResource Lotus.NavItem}"
                    Tag="catalog">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <FontIcon FontSize="16" Glyph="&#xE8F1;" />
                        <TextBlock Text="{local:Str Key=NavCatalog}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton
                    x:Name="NavDownloads"
                    AutomationProperties.Name="{local:Str Key=NavDownloads}"
                    Checked="OnNavChecked"
                    GroupName="Nav"
                    Style="{StaticResource Lotus.NavItem}"
                    Tag="downloads">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <FontIcon FontSize="16" Glyph="&#xE896;" />
                        <TextBlock Text="{local:Str Key=NavDownloads}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton
                    x:Name="NavLotus"
                    AutomationProperties.Name="{local:Str Key=NavLotus}"
                    Checked="OnNavChecked"
                    GroupName="Nav"
                    Style="{StaticResource Lotus.NavItem}"
                    Tag="lotus">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <controls:LotusPetal
                            Width="18"
                            Height="16"
                            IsLit="False" />
                        <TextBlock Text="{local:Str Key=NavLotus}" />
                    </StackPanel>
                </RadioButton>
                <Rectangle
                    Height="1"
                    Margin="10,18"
                    Fill="{StaticResource Stroke.Subtle}" />
                <RadioButton
                    x:Name="NavSettings"
                    AutomationProperties.Name="{local:Str Key=NavSettings}"
                    Checked="OnNavChecked"
                    GroupName="Nav"
                    Style="{StaticResource Lotus.NavItem}"
                    Tag="settings">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <FontIcon FontSize="16" Glyph="&#xE713;" />
                        <TextBlock Text="{local:Str Key=NavSettings}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton
                    x:Name="NavHelp"
                    AutomationProperties.Name="{local:Str Key=NavHelp}"
                    Checked="OnNavChecked"
                    GroupName="Nav"
                    Style="{StaticResource Lotus.NavItem}"
                    Tag="help">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <FontIcon FontSize="16" Glyph="&#xE897;" />
                        <TextBlock Text="{local:Str Key=NavHelp}" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>

            <!--  Lotus connection: honest state, the integration arrives in phase 5.  -->
            <Button
                Grid.Row="3"
                Padding="14,12"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                AutomationProperties.Name="{local:Str Key=LotusStatusAutomation}"
                Background="{StaticResource Bg.Surface}"
                BorderBrush="{StaticResource Stroke.Subtle}"
                Click="OnLotusStatusClick"
                CornerRadius="12">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <controls:LotusPetal
                        Width="30"
                        Height="26"
                        IsLit="False" />
                    <StackPanel Spacing="4">
                        <TextBlock
                            FontWeight="SemiBold"
                            Foreground="{StaticResource Text.Primary}"
                            Text="Lotus" />
                        <controls:StateBadge Text="{local:Str Key=BadgeInDevelopment}" Tone="Unknown" />
                    </StackPanel>
                </StackPanel>
            </Button>
        </Grid>

        <Frame
            x:Name="ContentFrame"
            Grid.Column="1"
            IsNavigationStackEnabled="False" />

        <!--  Window drag area over the top of the window; caption buttons sit on the right.  -->
        <Border
            x:Name="DragRegion"
            Grid.ColumnSpan="2"
            Height="40"
            VerticalAlignment="Top"
            Background="Transparent" />
    </Grid>
</Window>
