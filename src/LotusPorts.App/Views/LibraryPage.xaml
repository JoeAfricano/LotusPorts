<Page
    x:Class="LotusPorts.App.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:LotusPorts.App"
    xmlns:cards="using:LotusPorts.App.Controls"
    xmlns:controls="using:Lotus.Design.Controls"
    xmlns:local="using:LotusPorts.App">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <StackPanel>
            <Grid Height="280">
                <controls:SceneHero Source="Assets/Art/Scenes/04_FUNDO_SANTUARIO_LUNAR_HERO_COMPACT_1440x520.png" />
                <StackPanel
                    MaxWidth="660"
                    Margin="48,0,48,26"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Spacing="4">
                    <TextBlock
                        CharacterSpacing="160"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Accent.Rose}"
                        Text="{local:Str Key=LibraryEyebrow}" />
                    <TextBlock Style="{StaticResource Type.Display}" Text="{local:Str Key=NavLibrary}" />
                    <TextBlock
                        Foreground="{StaticResource Text.Secondary}"
                        Style="{StaticResource Type.Body}"
                        Text="{local:Str Key=LibrarySubtitle}" />
                    <AutoSuggestBox
                        x:Name="SearchBox"
                        Width="580"
                        Margin="0,16,0,0"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="{local:Str Key=SearchAutomation}"
                        DisplayMemberPath="Title"
                        ItemsSource="{x:Bind ViewModel.Search.Suggestions}"
                        PlaceholderText="{local:Str Key=SearchPlaceholder}"
                        QueryIcon="Find"
                        QuerySubmitted="OnQuerySubmitted"
                        TextChanged="OnSearchTextChanged"
                        UpdateTextOnSelect="False" />
                </StackPanel>
            </Grid>

            <StackPanel Margin="48,8,48,48" Spacing="18">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromVerticalOffset="28" IsStaggeringEnabled="True" />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <RadioButton
                        Checked="OnTabChecked"
                        Content="{x:Bind ViewModel.AllLabel, Mode=OneWay}"
                        GroupName="LibraryTab"
                        IsChecked="True"
                        Style="{StaticResource Lotus.Pill}"
                        Tag="All" />
                    <RadioButton
                        Checked="OnTabChecked"
                        Content="{x:Bind ViewModel.FavoritesLabel, Mode=OneWay}"
                        GroupName="LibraryTab"
                        Style="{StaticResource Lotus.Pill}"
                        Tag="Favorites" />
                    <RadioButton
                        Checked="OnTabChecked"
                        Content="{x:Bind ViewModel.InstalledLabel, Mode=OneWay}"
                        GroupName="LibraryTab"
                        Style="{StaticResource Lotus.Pill}"
                        Tag="Installed" />
                </StackPanel>

                <Border Style="{StaticResource Lotus.Card}" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                    <StackPanel Spacing="4" Padding="0,0,0,24">
                        <controls:EmptyState
                            Illustration="Assets/Art/Illustrations/biblioteca-vazia.png"
                            Message="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}"
                            Title="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}" />
                        <StackPanel
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="10">
                            <Button
                                Click="OnGoHome"
                                Content="{local:Str Key=LibraryGoHome}"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button Click="OnGoCatalog" Content="{local:Str Key=LibraryGoCatalog}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Shelves}" Visibility="{x:Bind ViewModel.IsReady, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="26" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="app:ShelfModel">
                            <StackPanel Spacing="10">
                                <TextBlock Style="{StaticResource Type.Subtitle}" Text="{x:Bind Title}" />
                                <ScrollViewer
                                    HorizontalScrollBarVisibility="Auto"
                                    HorizontalScrollMode="Enabled"
                                    VerticalScrollBarVisibility="Disabled"
                                    VerticalScrollMode="Disabled">
                                    <ItemsRepeater Margin="0,0,0,12" ItemsSource="{x:Bind Games}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Orientation="Horizontal" Spacing="14" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="app:GameCardModel">
                                                <cards:GameCard Model="{x:Bind}" />
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </ScrollViewer>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
