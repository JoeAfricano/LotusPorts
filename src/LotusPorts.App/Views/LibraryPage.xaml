<Page
    x:Class="LotusPorts.App.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:LotusPorts.App"
    xmlns:cards="using:LotusPorts.App.Controls"
    xmlns:controls="using:Lotus.Design.Controls"
    xmlns:local="using:LotusPorts.App">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <StackPanel>
            <Grid Height="360">
                <controls:SakuraHero />
                <StackPanel
                    MaxWidth="660"
                    Margin="48,0,48,28"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom">
                    <TextBlock Style="{StaticResource Type.Display}" Text="{local:Str Key=LibraryHeroLine1}" />
                    <TextBlock
                        Margin="0,-4,0,12"
                        Foreground="{StaticResource Accent.Rose}"
                        Style="{StaticResource Type.Display}"
                        Text="{local:Str Key=LibraryHeroLine2}" />
                    <TextBlock
                        MaxWidth="520"
                        HorizontalAlignment="Left"
                        Foreground="{StaticResource Text.Secondary}"
                        Style="{StaticResource Type.Body}"
                        Text="{local:Str Key=LibraryHeroSubtitle}" />
                    <AutoSuggestBox
                        x:Name="SearchBox"
                        Width="580"
                        Margin="0,22,0,0"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="{local:Str Key=SearchAutomation}"
                        DisplayMemberPath="Title"
                        ItemsSource="{x:Bind ViewModel.Suggestions}"
                        PlaceholderText="{local:Str Key=SearchPlaceholder}"
                        QueryIcon="Find"
                        QuerySubmitted="OnQuerySubmitted"
                        TextChanged="OnSearchTextChanged"
                        UpdateTextOnSelect="False" />
                </StackPanel>
            </Grid>

            <StackPanel Margin="48,0,48,48" Spacing="18">
                <!--  Tabs (concept art) and minimal chips  -->
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <RadioButton
                        x:Name="TabAll"
                        Checked="OnTabChecked"
                        Content="{x:Bind ViewModel.AllLabel, Mode=OneWay}"
                        GroupName="LibraryTab"
                        IsChecked="True"
                        Style="{StaticResource Lotus.Pill}"
                        Tag="All" />
                    <RadioButton
                        Checked="OnTabChecked"
                        Content="{x:Bind ViewModel.FavoritesLabel, Mode=OneWay}"
                        GroupName="LibraryTab"
                        Style="{StaticResource Lotus.Pill}"
                        Tag="Favorites" />
                    <RadioButton
                        Checked="OnTabChecked"
                        Content="{x:Bind ViewModel.InstalledLabel, Mode=OneWay}"
                        GroupName="LibraryTab"
                        Style="{StaticResource Lotus.Pill}"
                        Tag="Installed" />
                    <RadioButton
                        Checked="OnTabChecked"
                        Content="{x:Bind ViewModel.NotInstalledLabel, Mode=OneWay}"
                        GroupName="LibraryTab"
                        Style="{StaticResource Lotus.Pill}"
                        Tag="NotInstalled" />
                </StackPanel>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Hidden"
                        HorizontalScrollMode="Enabled"
                        VerticalScrollBarVisibility="Disabled"
                        VerticalScrollMode="Disabled">
                        <StackPanel
                            x:Name="PlatformChips"
                            Orientation="Horizontal"
                            Spacing="8" />
                    </ScrollViewer>
                    <ComboBox
                        x:Name="GenreBox"
                        Grid.Column="1"
                        MinWidth="170"
                        AutomationProperties.Name="{local:Str Key=FilterGenre}"
                        SelectionChanged="OnGenreChanged" />
                </Grid>

                <!--  Skeleton while loading  -->
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="16"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
                    <Border
                        Width="176"
                        Height="236"
                        Background="{StaticResource Bg.Surface}"
                        CornerRadius="12" />
                    <Border
                        Width="176"
                        Height="236"
                        Background="{StaticResource Bg.Surface}"
                        CornerRadius="12" />
                    <Border
                        Width="176"
                        Height="236"
                        Background="{StaticResource Bg.Surface}"
                        CornerRadius="12" />
                    <Border
                        Width="176"
                        Height="236"
                        Background="{StaticResource Bg.Surface}"
                        CornerRadius="12" />
                </StackPanel>

                <Border Style="{StaticResource Lotus.Card}" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                    <controls:EmptyState Message="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}" Title="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}" />
                </Border>

                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Shelves}" Visibility="{x:Bind ViewModel.IsReady, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="26" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="app:ShelfModel">
                            <StackPanel Spacing="10">
                                <TextBlock Style="{StaticResource Type.Subtitle}" Text="{x:Bind Title}" />
                                <ScrollViewer
                                    HorizontalScrollBarVisibility="Auto"
                                    HorizontalScrollMode="Enabled"
                                    VerticalScrollBarVisibility="Disabled"
                                    VerticalScrollMode="Disabled">
                                    <ItemsRepeater Margin="0,0,0,12" ItemsSource="{x:Bind Games}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Orientation="Horizontal" Spacing="14" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="app:GameCardModel">
                                                <cards:GameCard Model="{x:Bind}" />
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </ScrollViewer>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                <HyperlinkButton
                    Click="OnDismissNew"
                    Content="{local:Str Key=ShelfNewDismiss}"
                    Visibility="{x:Bind ViewModel.HasNewShelf, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
