<Page
    x:Class="LotusPorts.App.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Lotus.Design.Controls"
    xmlns:local="using:LotusPorts.App">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <StackPanel>
            <Grid Height="390">
                <controls:SakuraHero />
                <StackPanel
                    MaxWidth="660"
                    Margin="48,0,48,36"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom">
                    <TextBlock Style="{StaticResource Type.Display}" Text="{local:Str Key=LibraryHeroLine1}" />
                    <TextBlock
                        Margin="0,-4,0,12"
                        Foreground="{StaticResource Accent.Rose}"
                        Style="{StaticResource Type.Display}"
                        Text="{local:Str Key=LibraryHeroLine2}" />
                    <TextBlock
                        MaxWidth="520"
                        HorizontalAlignment="Left"
                        Foreground="{StaticResource Text.Secondary}"
                        Style="{StaticResource Type.Body}"
                        Text="{local:Str Key=LibraryHeroSubtitle}" />
                    <AutoSuggestBox
                        x:Name="SearchBox"
                        Width="580"
                        Margin="0,22,0,0"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="{local:Str Key=SearchAutomation}"
                        DisplayMemberPath="Title"
                        ItemsSource="{x:Bind ViewModel.Suggestions}"
                        PlaceholderText="{local:Str Key=SearchPlaceholder}"
                        QueryIcon="Find"
                        QuerySubmitted="OnQuerySubmitted"
                        TextChanged="OnSearchTextChanged"
                        UpdateTextOnSelect="False" />
                </StackPanel>
            </Grid>

            <Grid Margin="48,4,48,48">
                <!--  Skeleton while loading  -->
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="16"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
                    <Border
                        Width="172"
                        Height="236"
                        Background="{StaticResource Bg.Surface}"
                        CornerRadius="12" />
                    <Border
                        Width="172"
                        Height="236"
                        Background="{StaticResource Bg.Surface}"
                        CornerRadius="12" />
                    <Border
                        Width="172"
                        Height="236"
                        Background="{StaticResource Bg.Surface}"
                        CornerRadius="12" />
                    <Border
                        Width="172"
                        Height="236"
                        Background="{StaticResource Bg.Surface}"
                        CornerRadius="12" />
                </StackPanel>
                <Border Style="{StaticResource Lotus.Card}" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                    <controls:EmptyState
                        BadgeText="{local:Str Key=BadgeInDevelopment}"
                        Message="{local:Str Key=LibraryEmptyMessage}"
                        Title="{local:Str Key=LibraryEmptyTitle}" />
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
