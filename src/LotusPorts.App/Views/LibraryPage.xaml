<Page
    x:Class="LotusPorts.App.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:LotusPorts.App"
    xmlns:cards="using:LotusPorts.App.Controls"
    xmlns:controls="using:Lotus.Design.Controls"
    xmlns:local="using:LotusPorts.App">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <StackPanel>
            <Grid Height="280">
                <controls:SceneHero Source="Assets/Art/Banners/lunar_torii.png" />
                <StackPanel
                    MaxWidth="660"
                    Margin="48,0,48,26"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Spacing="4">
                    <TextBlock
                        CharacterSpacing="160"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Accent.Rose}"
                        Text="{local:Str Key=LibraryEyebrow}" />
                    <TextBlock Style="{StaticResource Type.Display}" Text="{local:Str Key=NavLibrary}" />
                    <TextBlock
                        Foreground="{StaticResource Text.Secondary}"
                        Style="{StaticResource Type.Body}"
                        Text="{local:Str Key=LibrarySubtitle}" />
                    <AutoSuggestBox
                        x:Name="SearchBox"
                        Width="580"
                        Margin="0,16,0,0"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="{local:Str Key=SearchAutomation}"
                        DisplayMemberPath="Title"
                        ItemsSource="{x:Bind ViewModel.Search.Suggestions}"
                        PlaceholderText="{local:Str Key=SearchPlaceholder}"
                        QueryIcon="Find"
                        QuerySubmitted="OnQuerySubmitted"
                        TextChanged="OnSearchTextChanged"
                        UpdateTextOnSelect="False" />
                </StackPanel>
            </Grid>

            <StackPanel Margin="48,8,48,48" Spacing="18">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromVerticalOffset="28" IsStaggeringEnabled="True" />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <RadioButton
                        Checked="OnTabChecked"
                        Content="{x:Bind ViewModel.AllLabel, Mode=OneWay}"
                        GroupName="LibraryTab"
                        IsChecked="True"
                        Style="{StaticResource Lotus.Pill}"
                        Tag="All" />
                    <RadioButton
                        Checked="OnTabChecked"
                        Content="{x:Bind ViewModel.FavoritesLabel, Mode=OneWay}"
                        GroupName="LibraryTab"
                        Style="{StaticResource Lotus.Pill}"
                        Tag="Favorites" />
                    <RadioButton
                        Checked="OnTabChecked"
                        Content="{x:Bind ViewModel.InstalledLabel, Mode=OneWay}"
                        GroupName="LibraryTab"
                        Style="{StaticResource Lotus.Pill}"
                        Tag="Installed" />
                </StackPanel>
                <cards:PlatformRail x:Name="Rail" Visibility="Collapsed" />

                <Border
                    x:Name="UpdatesCard"
                    Padding="20,16"
                    Style="{StaticResource Lotus.Card}"
                    Visibility="Collapsed">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            FontSize="22"
                            Foreground="{StaticResource Accent.Rose}"
                            Glyph="&#xE895;" />
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock
                                x:Name="UpdatesTitle"
                                FontWeight="SemiBold"
                                Style="{StaticResource Type.Body}" />
                            <TextBlock
                                x:Name="UpdatesNames"
                                Style="{StaticResource Type.Caption}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button
                            x:Name="UpdateAllButton"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Click="OnUpdateAll"
                            Content="{local:Str Key=UpdateAll}"
                            Style="{StaticResource AccentButtonStyle}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Lotus.Card}" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                    <StackPanel Spacing="4" Padding="0,0,0,24">
                        <controls:EmptyState
                            Illustration="Assets/Art/Illustrations/biblioteca-vazia.png"
                            Message="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}"
                            Title="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}" />
                        <StackPanel
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="10">
                            <Button
                                Click="OnGoHome"
                                Content="{local:Str Key=LibraryGoHome}"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button Click="OnGoCatalog" Content="{local:Str Key=LibraryGoCatalog}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Shelves}" Visibility="{x:Bind ViewModel.IsReady, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="34" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="app:ShelfModel">
                            <StackPanel Spacing="14">
                                <controls:SectionHeader Glyph="&#xE8F1;" Title="{x:Bind Title}" />
                                <ItemsRepeater ItemsSource="{x:Bind Games}">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout
                                            MinColumnSpacing="16"
                                            MinItemWidth="180"
                                            MinRowSpacing="16" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="app:GameCardModel">
                                            <cards:GameCard Model="{x:Bind}" />
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
