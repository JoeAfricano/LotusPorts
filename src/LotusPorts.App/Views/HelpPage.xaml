<Page
    x:Class="LotusPorts.App.Views.HelpPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Lotus.Design.Controls"
    xmlns:local="using:LotusPorts.App">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <Grid Padding="48,56,48,48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="980" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="16">
                <controls:PageBanner Source="Assets/Art/Banners/aurora_peaks.png" Title="{local:Str Key=NavHelp}" />

                <!--  Built in code: one card per topic, icon + title + text.  -->
                <StackPanel x:Name="Topics" Spacing="12">
                    <StackPanel.ChildrenTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromVerticalOffset="24" IsStaggeringEnabled="True" />
                        </TransitionCollection>
                    </StackPanel.ChildrenTransitions>
                </StackPanel>

                <Border Style="{StaticResource Lotus.Card}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock Style="{StaticResource Type.Subtitle}" Text="{local:Str Key=HelpWelcomeTitle}" />
                            <TextBlock
                                Style="{StaticResource Type.Body}"
                                Foreground="{StaticResource Text.Secondary}"
                                Text="{local:Str Key=HelpWelcomeText}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Click="OnShowWelcome"
                            Content="{local:Str Key=HelpWelcomeButton}" />
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
