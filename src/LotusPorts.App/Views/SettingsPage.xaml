<Page
    x:Class="LotusPorts.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Lotus.Design.Controls"
    xmlns:local="using:LotusPorts.App"
    xmlns:vm="using:LotusPorts.App.ViewModels">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <Grid Padding="48,56,48,48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="980" />
            </Grid.ColumnDefinitions>
        <StackPanel
            Spacing="16">
            <controls:PageBanner Source="Assets/Art/Banners/cosmic_orbit.png" Title="{local:Str Key=NavSettings}" />
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind local:Ui.HasText(ViewModel.SaveError), Mode=OneWay}"
                Message="{x:Bind ViewModel.SaveError, Mode=OneWay}"
                Severity="Error" />

            <!--  Geral  -->
            <Border Style="{StaticResource Lotus.Card}">
                <StackPanel Spacing="22">
                    <TextBlock Style="{StaticResource Type.Subtitle}" Text="{local:Str Key=SettingsGeneral}" />

                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource Type.Body}" Text="{local:Str Key=SettingsLanguage}" />
                            <TextBlock Style="{StaticResource Type.Caption}" Text="{local:Str Key=SettingsLanguageHint}" />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            MinWidth="220"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{local:Str Key=SettingsLanguage}"
                            SelectedIndex="{x:Bind ViewModel.LanguageIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="Português (Brasil)" />
                            <ComboBoxItem Content="English (United States)" />
                        </ComboBox>
                    </Grid>
                    <InfoBar
                        Margin="0,-10,0,0"
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.RestartNeeded, Mode=OneWay}"
                        Message="{local:Str Key=SettingsRestartToApply}"
                        Severity="Informational" />

                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource Type.Body}" Text="{local:Str Key=SettingsLibraryFolder}" />
                            <TextBlock
                                IsTextSelectionEnabled="True"
                                Style="{StaticResource Type.Caption}"
                                Text="{x:Bind ViewModel.LibraryFolder, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource Type.Caption}" Text="{local:Str Key=SettingsLibraryFolderHint}" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Click="OnChooseLibraryFolder"
                            Content="{local:Str Key=SettingsChange}" />
                    </Grid>
                    <InfoBar
                        Margin="0,-10,0,0"
                        IsClosable="False"
                        IsOpen="{x:Bind local:Ui.HasText(ViewModel.LibraryFolderError), Mode=OneWay}"
                        Message="{x:Bind ViewModel.LibraryFolderError, Mode=OneWay}"
                        Severity="Warning" />

                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource Type.Body}" Text="{local:Str Key=SettingsDefaultStyle}" />
                            <TextBlock Style="{StaticResource Type.Caption}" Text="{local:Str Key=SettingsDefaultStyleHint}" />
                        </StackPanel>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MaxWidth="280" />
                                <ColumnDefinition Width="*" MaxWidth="280" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <RadioButton
                                x:Name="StyleOriginal"
                                AutomationProperties.Name="{local:Str Key=StyleOriginal}"
                                Checked="OnStyleChecked"
                                GroupName="DefaultStyle"
                                Style="{StaticResource Lotus.ChoiceCard}"
                                Tag="Original">
                                <StackPanel HorizontalAlignment="Center" Spacing="8">
                                    <FontIcon FontSize="30" Glyph="&#xE7FC;" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource Type.Subtitle}"
                                        Text="{local:Str Key=StyleOriginal}" />
                                    <TextBlock
                                        Style="{StaticResource Type.Caption}"
                                        Text="{local:Str Key=StyleOriginalHint}"
                                        TextAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton
                                x:Name="StyleRemastered"
                                Grid.Column="1"
                                AutomationProperties.Name="{local:Str Key=StyleRemastered}"
                                Checked="OnStyleChecked"
                                GroupName="DefaultStyle"
                                Style="{StaticResource Lotus.ChoiceCard}"
                                Tag="Remastered">
                                <StackPanel HorizontalAlignment="Center" Spacing="8">
                                    <FontIcon FontSize="30" Glyph="&#xE7F4;" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource Type.Subtitle}"
                                        Text="{local:Str Key=StyleRemastered}" />
                                    <TextBlock
                                        Style="{StaticResource Type.Caption}"
                                        Text="{local:Str Key=StyleRemasteredHint}"
                                        TextAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </Grid>
                    </StackPanel>

                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource Type.Body}" Text="{local:Str Key=SettingsAutoUpdate}" />
                            <TextBlock Style="{StaticResource Type.Caption}" Text="{local:Str Key=SettingsAutoUpdateHint}" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="1"
                            MinWidth="0"
                            AutomationProperties.Name="{local:Str Key=SettingsAutoUpdate}"
                            IsOn="{x:Bind ViewModel.AutoUpdate, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </Grid>

                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Type.Body}" Text="{local:Str Key=SettingsStartWithWindows}" />
                        <controls:StateBadge Grid.Column="1" Text="{local:Str Key=BadgeInDevelopment}" />
                    </Grid>
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource Type.Body}" Text="{local:Str Key=SettingsTvMode}" />
                            <TextBlock
                                Style="{StaticResource Type.Caption}"
                                Text="{local:Str Key=SettingsTvModeHint}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="TvModeToggle"
                            Grid.Column="1"
                            MinWidth="0"
                            AutomationProperties.Name="{local:Str Key=SettingsTvMode}"
                            OffContent=""
                            OnContent=""
                            Toggled="OnTvModeToggled" />
                    </Grid>
                </StackPanel>
            </Border>

            <!--  Aparência, as in Lotus: mode cards that preview themselves, accent dots, the theme gallery and the Home banner  -->
            <Border Style="{StaticResource Lotus.Card}">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource Type.Subtitle}" Text="{local:Str Key=AppearanceTitle}" />
                        <TextBlock
                            Style="{StaticResource Type.Caption}"
                            Text="{local:Str Key=AppearanceHint}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid ColumnSpacing="24" RowSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <VariableSizedWrapGrid
                            x:Name="ThemeCards"
                            ItemHeight="128"
                            ItemWidth="196"
                            Orientation="Horizontal" />
                        <StackPanel
                            x:Name="AccentArea"
                            Grid.Column="1"
                            MinWidth="220"
                            Spacing="12">
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="{local:Str Key=AppearanceAccent}" />
                            <VariableSizedWrapGrid
                                x:Name="AccentDots"
                                ItemHeight="56"
                                ItemWidth="56"
                                MaximumRowsOrColumns="4"
                                Orientation="Horizontal" />
                            <TextBlock x:Name="AccentName" Style="{StaticResource Type.Caption}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,6,0,0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="{local:Str Key=AppearanceGallery}" />
                            <TextBlock
                                Style="{StaticResource Type.Caption}"
                                Text="{local:Str Key=AppearanceGalleryHint}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Click="OnPasteTheme">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="13" Glyph="&#xE77F;" />
                                <TextBlock Text="{local:Str Key=AppearancePaste}" />
                            </StackPanel>
                        </Button>
                        <Button
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Click="OnCreateInLotus"
                            Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="13" Glyph="&#xE790;" />
                                <TextBlock Text="{local:Str Key=AppearanceCreateInLotus}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock
                        x:Name="AppearanceStatus"
                        Foreground="{StaticResource Accent.Rose}"
                        Style="{StaticResource Type.Caption}"
                        TextWrapping="Wrap" />
                    <VariableSizedWrapGrid
                        x:Name="GalleryCards"
                        ItemHeight="158"
                        ItemWidth="214"
                        Orientation="Horizontal" />

                    <StackPanel Spacing="8">
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="{local:Str Key=AppearanceHomeBanner}" />
                        <GridView
                            x:Name="BannerChoices"
                            IsItemClickEnabled="True"
                            ItemClick="OnBannerClick"
                            SelectionMode="Single" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  Arquivos de jogo: watched folders and the files recognized there (phase 3)  -->
            <Border Style="{StaticResource Lotus.Card}">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource Type.Subtitle}" Text="{local:Str Key=SettingsGameFiles}" />
                            <TextBlock
                                Style="{StaticResource Type.Caption}"
                                Text="{local:Str Key=SettingsGameFilesHint}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button Click="OnAddGameFolder" Content="{local:Str Key=GameFilesAddFolder}" />
                            <Button
                                x:Name="ScanButton"
                                Click="OnScanGameFiles"
                                Content="{local:Str Key=GameFilesScan}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock
                        x:Name="GameFilesStatus"
                        Style="{StaticResource Type.Caption}"
                        TextWrapping="Wrap" />
                    <StackPanel x:Name="GameFolderList" Spacing="6" />
                    <StackPanel x:Name="RecognizedList" Spacing="6" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Lotus.Card}">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource Type.Subtitle}" Text="{local:Str Key=SettingsCatalogSources}" />
                        <TextBlock Style="{StaticResource Type.Caption}" Text="{local:Str Key=SettingsCatalogSourcesHint}" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Click="OnOpenCatalogSources"
                        Content="{local:Str Key=SettingsCatalogSourcesOpen}" />
                </Grid>
            </Border>

            <!--  Modo avançado  -->
            <Border Style="{StaticResource Lotus.Card}">
                <StackPanel Spacing="16">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource Type.Subtitle}" Text="{local:Str Key=SettingsAdvanced}" />
                            <TextBlock Style="{StaticResource Type.Caption}" Text="{local:Str Key=SettingsAdvancedHint}" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="1"
                            MinWidth="0"
                            AutomationProperties.Name="{local:Str Key=SettingsAdvanced}"
                            IsOn="{x:Bind ViewModel.AdvancedMode, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </Grid>
                    <StackPanel Spacing="14" Visibility="{x:Bind ViewModel.AdvancedMode, Mode=OneWay}">
                        <Rectangle Height="1" Fill="{StaticResource Stroke.Subtle}" />
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource Type.Body}" Text="{local:Str Key=SettingsShowInReview}" />
                                <TextBlock Style="{StaticResource Type.Caption}" Text="{local:Str Key=SettingsShowInReviewHint}" />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="1"
                                MinWidth="0"
                                AutomationProperties.Name="{local:Str Key=SettingsShowInReview}"
                                IsOn="{x:Bind ViewModel.ShowInReview, Mode=TwoWay}"
                                OffContent=""
                                OnContent="" />
                        </Grid>
                        <Rectangle Height="1" Fill="{StaticResource Stroke.Subtle}" />
                        <TextBlock Style="{StaticResource Type.Body}" Text="{local:Str Key=SettingsJournal}" />
                        <TextBlock
                            Style="{StaticResource Type.Caption}"
                            Text="{local:Str Key=SettingsJournalEmpty}"
                            Visibility="{x:Bind ViewModel.JournalEmpty, Mode=OneWay}" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Journal}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="8" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:JournalRow">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Type.Caption}" Text="{x:Bind When}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource Type.Body}">
                                            <Run Text="{x:Bind Kind}" /><Run Foreground="{StaticResource Text.Secondary}" Text="  " /><Run Foreground="{StaticResource Text.Secondary}" Text="{x:Bind PortId}" />
                                        </TextBlock>
                                        <controls:StateBadge
                                            Grid.Column="2"
                                            Text="{x:Bind Outcome}"
                                            Tone="{x:Bind Tone}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <Rectangle Height="1" Fill="{StaticResource Stroke.Subtle}" />
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource Type.Body}" Text="{local:Str Key=SettingsDataFolder}" />
                                <TextBlock
                                    IsTextSelectionEnabled="True"
                                    Style="{StaticResource Type.Caption}"
                                    Text="{x:Bind ViewModel.DataFolder}" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Click="OnOpenDataFolder"
                                Content="{local:Str Key=SettingsOpenFolder}" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  Sobre / Legal  -->
            <Border Style="{StaticResource Lotus.Card}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource Type.Subtitle}" Text="{local:Str Key=SettingsAbout}" />
                    <TextBlock Style="{StaticResource Type.Body}">
                        <Run Text="Lotus Ports" /><Run Foreground="{StaticResource Text.Secondary}" Text="{x:Bind local:Ui.VersionLabel(ViewModel.Version)}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Type.Body}" Text="{local:Str Key=LegalNotAffiliated}" />
                    <TextBlock Style="{StaticResource Type.Body}" Text="{local:Str Key=LegalNoGameFiles}" />
                    <TextBlock Style="{StaticResource Type.Caption}" Text="{local:Str Key=LegalPortLicenses}" />
                    <TextBlock
                        Margin="0,6,0,0"
                        Style="{StaticResource Type.Body}"
                        Text="{local:Str Key=LegalComponentsTitle}" />
                    <TextBlock Style="{StaticResource Type.Caption}" Text="{local:Str Key=LegalComponents}" />
                </StackPanel>
            </Border>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
