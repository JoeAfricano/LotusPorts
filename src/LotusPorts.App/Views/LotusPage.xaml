<Page
    x:Class="LotusPorts.App.Views.LotusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Lotus.Design.Controls"
    xmlns:local="using:LotusPorts.App">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <Grid Padding="48,56,48,48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="980" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="16">
                <StackPanel Spacing="6">
                    <controls:PageBanner Source="Assets/Art/Banners/lotus_river.png" Title="{local:Str Key=LotusTitle}" />
                    <TextBlock
                        Foreground="{StaticResource Text.Secondary}"
                        Style="{StaticResource Type.Body}"
                        Text="{local:Str Key=LotusSubtitle}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!--  Connection status, always honest  -->
                <Border Style="{StaticResource Lotus.Card}">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <controls:LotusPetal
                            x:Name="StatusPetal"
                            Width="58"
                            Height="50"
                            VerticalAlignment="Center" />
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="6">
                            <TextBlock x:Name="StatusTitle" Style="{StaticResource Type.Subtitle}" />
                            <TextBlock
                                x:Name="StatusText"
                                Style="{StaticResource Type.Caption}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Spacing="8">
                            <Button
                                x:Name="OpenLotusButton"
                                Click="OnOpenLotus"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button
                                x:Name="RetryButton"
                                HorizontalAlignment="Stretch"
                                Click="OnRetry"
                                Content="{local:Str Key=LotusRetry}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  What works right now: only what Lotus announced  -->
                <Border Style="{StaticResource Lotus.Card}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource Type.Subtitle}" Text="{local:Str Key=LotusFeaturesTitle}" />
                        <StackPanel x:Name="FeatureList" Spacing="10" />
                    </StackPanel>
                </Border>

                <!--  Permissions (section 12.10)  -->
                <Border Style="{StaticResource Lotus.Card}">
                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource Type.Subtitle}" Text="{local:Str Key=LotusPermissionsTitle}" />
                        <TextBlock
                            Margin="0,0,0,6"
                            Style="{StaticResource Type.Caption}"
                            Text="{local:Str Key=LotusPermissionsHint}"
                            TextWrapping="Wrap" />
                        <StackPanel x:Name="PermissionList" Spacing="2" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
