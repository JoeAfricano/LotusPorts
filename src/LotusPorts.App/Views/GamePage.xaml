<Page
    x:Class="LotusPorts.App.Views.GamePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Lotus.Design.Controls"
    xmlns:local="using:LotusPorts.App">

    <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <Grid>
        <!--  Scene banner behind the top of the page (premium art); the content sits over it.  -->
        <controls:SceneHero
            Height="380"
            VerticalAlignment="Top"
            Source="Assets/Art/Scenes/04_FUNDO_SANTUARIO_LUNAR_CARD_WIDE_1200x500.png" />
        <Grid Padding="40,52,48,48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="1100" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="20">
                <Button
                    Padding="12,7"
                    Background="{StaticResource Bg.Surface}"
                    BorderBrush="{StaticResource Stroke.Subtle}"
                    Click="OnBack"
                    CornerRadius="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon FontSize="13" Glyph="&#xE72B;" />
                        <TextBlock Text="{local:Str Key=GameBack}" />
                    </StackPanel>
                </Button>

                <Border
                    x:Name="NotFound"
                    Style="{StaticResource Lotus.Card}"
                    Visibility="Collapsed">
                    <controls:EmptyState Message="{local:Str Key=GameNotFoundMessage}" Title="{local:Str Key=GameNotFoundTitle}" />
                </Border>

                <StackPanel
                    x:Name="Details"
                    Spacing="18"
                    Visibility="Collapsed">
                    <StackPanel.ChildrenTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromVerticalOffset="28" IsStaggeringEnabled="True" />
                        </TransitionCollection>
                    </StackPanel.ChildrenTransitions>
                    <!--  Top: cover, title, badges, description  -->
                    <Grid ColumnSpacing="28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:GameCover
                            x:Name="Cover"
                            Width="210"
                            Height="282"
                            TitleSize="21" />
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="12">
                            <TextBlock
                                x:Name="TitleText"
                                FontSize="32"
                                Style="{StaticResource Type.Display}" />
                            <StackPanel
                                x:Name="Badges"
                                Orientation="Horizontal"
                                Spacing="8" />
                            <TextBlock
                                x:Name="Description"
                                MaxWidth="640"
                                HorizontalAlignment="Left"
                                Foreground="{StaticResource Text.Secondary}"
                                Style="{StaticResource Type.Body}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ToggleButton
                                    x:Name="FavoriteButton"
                                    Padding="10,8"
                                    AutomationProperties.Name="{local:Str Key=GameFavorite}"
                                    Click="OnFavorite"
                                    CornerRadius="999"
                                    ToolTipService.ToolTip="{local:Str Key=GameFavorite}">
                                    <FontIcon
                                        x:Name="FavoriteIcon"
                                        FontSize="15"
                                        Glyph="&#xEB51;" />
                                </ToggleButton>
                                <Button
                                    Padding="10,8"
                                    AutomationProperties.Name="{local:Str Key=GameMore}"
                                    CornerRadius="999"
                                    ToolTipService.ToolTip="{local:Str Key=GameMore}">
                                    <FontIcon FontSize="15" Glyph="&#xE712;" />
                                    <Button.Flyout>
                                        <MenuFlyout x:Name="MoreMenu" />
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!--  Recommended port (concept art) -->
                    <Border Style="{StaticResource Lotus.Card}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                VerticalAlignment="Top"
                                FontSize="22"
                                Foreground="{StaticResource State.Warn}"
                                Glyph="&#xE734;" />
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock>
                                    <Run
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource Accent.Pink}"
                                        Text="{local:Str Key=GameRecommended}" /><Run Text="   " /><Run x:Name="RecommendedTitle" FontWeight="SemiBold" />
                                </TextBlock>
                                <TextBlock x:Name="RecommendedReason" Style="{StaticResource Type.Caption}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  Main action: one button whose meaning follows the game's state (section 7.3)  -->
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="8">
                            <Button
                                x:Name="MainButton"
                                MinWidth="250"
                                Padding="24,14"
                                Click="OnMainClick"
                                CornerRadius="12"
                                IsEnabled="False"
                                Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon
                                        x:Name="MainIcon"
                                        FontSize="16"
                                        Glyph="&#xE896;" />
                                    <TextBlock
                                        x:Name="MainText"
                                        FontSize="17"
                                        FontWeight="SemiBold"
                                        Text="{local:Str Key=PlayChecking}" />
                                </StackPanel>
                            </Button>
                            <ProgressBar
                                x:Name="MainProgress"
                                MinWidth="250"
                                Maximum="1"
                                Visibility="Collapsed" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="6">
                            <TextBlock
                                x:Name="PlayStatus"
                                Style="{StaticResource Type.Body}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="PlayDetail"
                                Style="{StaticResource Type.Caption}"
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />
                            <StackPanel
                                x:Name="PlayLinks"
                                Orientation="Horizontal"
                                Spacing="4" />
                        </StackPanel>
                    </Grid>

                    <!--  Status tiles: nothing checked yet, so nothing is OK  -->
                    <Grid x:Name="Tiles" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                    </Grid>

                    <!--  Style: only when the port's keys were confirmed in its real configuration (section 5.6)  -->
                    <Border
                        x:Name="StyleCard"
                        Style="{StaticResource Lotus.Card}"
                        Visibility="Collapsed">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource Type.Subtitle}" Text="{local:Str Key=StyleTitle}" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <ToggleButton
                                    x:Name="StyleOriginal"
                                    Click="OnStyleOriginal"
                                    Content="{local:Str Key=StyleOriginal}" />
                                <ToggleButton
                                    x:Name="StyleRemastered"
                                    Click="OnStyleRemastered"
                                    Content="{local:Str Key=StyleRemastered}" />
                                <HyperlinkButton
                                    x:Name="StyleUndo"
                                    Click="OnStyleUndo"
                                    Content="{local:Str Key=StyleUndo}" />
                            </StackPanel>
                            <TextBlock
                                x:Name="StyleStatus"
                                Style="{StaticResource Type.Caption}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!--  Sua experiência: only what Lotus measured (section 12.6)  -->
                    <Border
                        x:Name="ExperienceCard"
                        Style="{StaticResource Lotus.Card}"
                        Visibility="Collapsed">
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <controls:LotusPetal
                                    Width="28"
                                    Height="24"
                                    IsLit="True" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource Type.Subtitle}"
                                    Text="{local:Str Key=ExperienceTitle}" />
                                <ToggleSwitch
                                    x:Name="ProfileToggle"
                                    Grid.Column="2"
                                    Header="{local:Str Key=ExperienceUseProfile}"
                                    Toggled="OnProfileToggled" />
                            </Grid>
                            <TextBlock
                                x:Name="ExperienceSession"
                                Style="{StaticResource Type.Body}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="ExperienceDriver"
                                Foreground="{StaticResource State.Warn}"
                                Style="{StaticResource Type.Caption}"
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />
                            <Border
                                x:Name="SuggestionBox"
                                Padding="14,10"
                                Background="{StaticResource Bg.Elevated}"
                                CornerRadius="10"
                                Visibility="Collapsed">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            x:Name="SuggestionText"
                                            FontWeight="SemiBold"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            x:Name="SuggestionEvidence"
                                            Style="{StaticResource Type.Caption}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            x:Name="SuggestionComparison"
                                            Style="{StaticResource Type.Caption}"
                                            TextWrapping="Wrap"
                                            Visibility="Collapsed" />
                                    </StackPanel>
                                    <Button
                                        x:Name="SuggestionApply"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Click="OnApplySuggestion"
                                        Content="{local:Str Key=ExperienceApply}"
                                        Style="{StaticResource AccentButtonStyle}" />
                                </Grid>
                            </Border>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <HyperlinkButton x:Name="LotusReportLink" Content="{local:Str Key=ExperienceOpenReport}" />
                                <HyperlinkButton x:Name="LotusProfileLink" Content="{local:Str Key=ExperienceEditProfile}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!--  How to play: the usage part of the port's README, as the authors wrote it (only when it exists)  -->
                    <Border
                        x:Name="GuideCard"
                        Style="{StaticResource Lotus.Card}"
                        Visibility="Collapsed">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontSize="20"
                                    Foreground="{StaticResource Accent.Pink}"
                                    Glyph="&#xE736;" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Style="{StaticResource Type.Subtitle}" Text="{local:Str Key=GuideTitle}" />
                                    <TextBlock
                                        x:Name="GuideHint"
                                        Style="{StaticResource Type.Caption}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <HyperlinkButton
                                    x:Name="GuideSource"
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Content="{local:Str Key=GuideOpenSource}" />
                            </Grid>
                            <RichTextBlock
                                x:Name="GuideText"
                                MaxHeight="420"
                                IsTextSelectionEnabled="True"
                                TextWrapping="Wrap" />
                            <HyperlinkButton
                                x:Name="GuideMore"
                                Padding="0,2"
                                Click="OnGuideMore"
                                Content="{local:Str Key=GuideShowAll}"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <!--  About this port  -->
                    <Border Style="{StaticResource Lotus.Card}">
                        <StackPanel x:Name="About" Spacing="12">
                            <TextBlock Style="{StaticResource Type.Subtitle}" Text="{local:Str Key=GameAbout}" />
                        </StackPanel>
                    </Border>

                    <Expander
                        x:Name="OtherWays"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch">
                        <StackPanel x:Name="OtherWaysList" Spacing="12" />
                    </Expander>
                </StackPanel>
            </StackPanel>
        </Grid>
        </Grid>
    </ScrollViewer>
</Page>
