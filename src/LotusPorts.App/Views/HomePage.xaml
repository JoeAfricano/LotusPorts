<Page
    x:Class="LotusPorts.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:LotusPorts.App"
    xmlns:cards="using:LotusPorts.App.Controls"
    xmlns:controls="using:Lotus.Design.Controls"
    xmlns:local="using:LotusPorts.App"
    xmlns:vm="using:LotusPorts.App.ViewModels">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <StackPanel>
            <!--  Hero: thesis + search + the latest release (measured)  -->
            <Grid Height="400">
                <controls:SceneHero Source="Assets/Art/Scenes/05_FUNDO_JARDIM_CIBERNETICO_HERO_WIDE_1920x650.png" />
                <StackPanel
                    MaxWidth="680"
                    Margin="48,0,48,30"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Spacing="0">
                    <TextBlock Style="{StaticResource Type.Display}" Text="{local:Str Key=LibraryHeroLine1}" />
                    <TextBlock
                        Margin="0,-4,0,12"
                        Foreground="{StaticResource Accent.Rose}"
                        Style="{StaticResource Type.Display}"
                        Text="{local:Str Key=LibraryHeroLine2}" />
                    <TextBlock
                        MaxWidth="520"
                        HorizontalAlignment="Left"
                        Foreground="{StaticResource Text.Secondary}"
                        Style="{StaticResource Type.Body}"
                        Text="{local:Str Key=HomeSubtitle}" />
                    <AutoSuggestBox
                        x:Name="SearchBox"
                        Width="580"
                        Margin="0,20,0,0"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="{local:Str Key=SearchAutomation}"
                        DisplayMemberPath="Title"
                        ItemsSource="{x:Bind Search.Suggestions}"
                        PlaceholderText="{local:Str Key=SearchPlaceholder}"
                        QueryIcon="Find"
                        QuerySubmitted="OnQuerySubmitted"
                        TextChanged="OnSearchTextChanged"
                        UpdateTextOnSelect="False" />
                </StackPanel>

                <!--  Featured card on the right  -->
                <Button
                    MaxWidth="340"
                    Margin="0,0,48,34"
                    Padding="18,14"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    HorizontalContentAlignment="Stretch"
                    AutomationProperties.Name="{x:Bind ViewModel.FeaturedTitle, Mode=OneWay}"
                    Background="{StaticResource Bg.Surface}"
                    BorderBrush="{StaticResource Accent.Rose}"
                    Click="OnFeatured"
                    CornerRadius="14"
                    Visibility="{x:Bind ViewModel.HasFeatured, Mode=OneWay}">
                    <StackPanel Spacing="4">
                        <TextBlock
                            CharacterSpacing="120"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource Accent.Pink}"
                            Text="{local:Str Key=HomeFeatured}" />
                        <TextBlock
                            FontSize="17"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.FeaturedTitle, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Type.Caption}" Text="{x:Bind ViewModel.FeaturedDetail, Mode=OneWay}" />
                    </StackPanel>
                </Button>
            </Grid>

            <StackPanel Margin="48,6,48,48" Spacing="28">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromVerticalOffset="28" IsStaggeringEnabled="True" />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>
                <Border Style="{StaticResource Lotus.Card}" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                    <controls:EmptyState
                        Illustration="Assets/Art/Illustrations/biblioteca-vazia.png"
                        Message="{local:Str Key=HomeEmptyMessage}"
                        Title="{local:Str Key=LibraryNothingReviewedTitle}" />
                </Border>

                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Shelves}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="26" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="app:ShelfModel">
                            <StackPanel Spacing="10">
                                <TextBlock Style="{StaticResource Type.Subtitle}" Text="{x:Bind Title}" />
                                <ScrollViewer
                                    HorizontalScrollBarVisibility="Auto"
                                    HorizontalScrollMode="Enabled"
                                    VerticalScrollBarVisibility="Disabled"
                                    VerticalScrollMode="Disabled">
                                    <ItemsRepeater Margin="0,0,0,12" ItemsSource="{x:Bind Games}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Orientation="Horizontal" Spacing="14" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="app:GameCardModel">
                                                <cards:GameCard Model="{x:Bind}" />
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </ScrollViewer>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!--  Browse by console  -->
                <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.HasConsoles, Mode=OneWay}">
                    <TextBlock Style="{StaticResource Type.Subtitle}" Text="{local:Str Key=HomeByConsole}" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Consoles}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                ItemsStretch="Fill"
                                MinColumnSpacing="10"
                                MinItemWidth="190"
                                MinRowSpacing="10" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:ConsoleTile">
                                <Button
                                    Padding="16,12"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    AutomationProperties.Name="{x:Bind Label}"
                                    Background="{StaticResource Bg.Surface}"
                                    BorderBrush="{StaticResource Stroke.Subtle}"
                                    Click="OnConsole"
                                    CornerRadius="12"
                                    Tag="{x:Bind Platform}">
                                    <StackPanel Spacing="2">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Label}" />
                                        <TextBlock Style="{StaticResource Type.Caption}" Text="{x:Bind CountText}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <!--  Categories  -->
                <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.HasGenres, Mode=OneWay}">
                    <TextBlock Style="{StaticResource Type.Subtitle}" Text="{local:Str Key=HomeCategories}" />
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Hidden"
                        HorizontalScrollMode="Enabled"
                        VerticalScrollBarVisibility="Disabled"
                        VerticalScrollMode="Disabled">
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Genres}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:GenreChip">
                                <Button
                                    Padding="14,7"
                                    Background="{StaticResource Bg.Surface}"
                                    BorderBrush="{StaticResource Stroke.Subtle}"
                                    Click="OnGenre"
                                    Content="{x:Bind Label}"
                                    CornerRadius="999"
                                    Tag="{x:Bind Genre}" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    </ScrollViewer>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
